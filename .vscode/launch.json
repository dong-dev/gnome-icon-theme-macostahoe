{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Generate Application Desktop Entires",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/generate-application-desktop-entries.mts",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Generate Theme",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/generate-theme.mts",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        }
    ]
}